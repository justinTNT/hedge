# Dependencies
node_modules/

# Build outputs
dist/
build/
_site/
.fable/

# Extension packaged builds
apps/microblog/extension/dist-*/
apps/microblog/extension/*.zip

# IDE
.idea/
*.swp
*.swo
.vscode/

# .NET
bin/
obj/
*.user
*.suo

# Cloudflare
.wrangler/
.dev.vars

# Extension config (contains admin keys)
apps/microblog/extension/sites.json

# Local secrets
/private/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# rich-text lib is copied from packages/rich-text at build time
apps/*/lib/rich-text/

# guest-session.js is copied from packages/hedge/lib at build time (prep:lib);
# generated per app, so ignore it everywhere — except music, which carries its
# own slimmer, divergent copy as tracked source.
apps/*/lib/guest-session.js
!apps/music/lib/guest-session.js
