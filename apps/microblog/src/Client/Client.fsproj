<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../packages/hedge/src/Client/GuestSession.fs" />
    <Compile Include="../../../../packages/hedge/src/Client/Api.fs" />
    <Compile Include="generated/ClientGen.fs" />
    <Compile Include="../../../../packages/rich-text/RichText.fs" />
    <!-- Shared content-client contract (immutable host context) the blog content
         module references; linked once before the module .props (unified shell, Stage 0). -->
    <Compile Include="../../../../packages/content-client/HostContext.fs" />
    <!-- Shared OAuth claim-return glue (parse + route pattern + return-nav) the host uses. -->
    <Compile Include="../../../../packages/content-client/ClaimGlue.fs" />
    <!-- Shared identity subsystem + UI (CP-B: the single identity authority this app's host uses). -->
    <Compile Include="../../../../packages/content-client/Identity.fs" />
    <Compile Include="../../../../packages/content-client/IdentityView.fs" />
    <!-- Shared comments renderer (Content.Comments) the blog content module consumes. -->
    <Compile Include="../../../../packages/content-client/Comments.fs" />
  </ItemGroup>
  <!-- Content client comes from the composed blog module (its own .props); this app's
       own content pages were removed. Blog is PRIMARY here, run at "/" by Blog/Main.fs. -->
  <Import Project="../../../../packages/modules/blog/blog.client.props" />
  <!-- idealist only: the alerts typed client (Alerts.ClientGen) the curator page consumes, gated like
       the alerts codecs/models below. Import before Curator/App.fs. -->
  <Import Project="../../../../packages/modules/alerts/alerts.client.props" Condition="'$(HEDGE_SITE)' == 'idealist'" />
  <ItemGroup>
    <!-- CP-B: the single-module host (chrome + shared identity + router) that runs the blog
         module via its hosted surface, mirroring the Justat shell. Blog/Main.fs runs it. -->
    <Compile Include="Blog/Chrome.fs" />
    <Compile Include="Blog/Host.fs" />
    <Compile Include="Blog/Main.fs" />
    <!-- darwin.news-specific glue, a separate /rhymes bundle -->
    <Compile Include="Rhyming/App.fs" />
    <!-- idealist curator page (a separate /curator bundle) — consumes Alerts.ClientGen, so it compiles
         only on idealist; vite.config.js gates the curator.html input the same way. -->
    <Compile Include="Curator/App.fs" Condition="'$(HEDGE_SITE)' == 'idealist'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../packages/hedge/src/Hedge/Hedge.fsproj" />
    <ProjectReference Include="../Models/Models.fsproj" />
    <ProjectReference Include="../../../../packages/modules/blog/src/Models/BlogModels.fsproj" />
    <!-- AlertsModels (Alerts.Api) for the curator's typed client — idealist only. -->
    <ProjectReference Include="../../../../packages/modules/alerts/src/Models/AlertsModels.fsproj" Condition="'$(HEDGE_SITE)' == 'idealist'" />
    <ProjectReference Include="../Codecs/Codecs.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.16.0" />
    <PackageReference Include="Feliz" Version="2.9.0" />
    <PackageReference Include="Feliz.Router" Version="4.0.0" />
    <PackageReference Include="Fable.Elmish" Version="4.2.0" />
    <PackageReference Include="Fable.Elmish.React" Version="4.0.0" />
    <PackageReference Include="Fable.Elmish.HMR" Version="7.0.0" />
    <PackageReference Include="Thoth.Fetch" Version="3.0.1" />
  </ItemGroup>
</Project>
