<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="generated/Codecs.fs" />
  </ItemGroup>
  <!-- Composed module codecs (Blog.Codecs) live with the module, not per-app. -->
  <Import Project="../../../../packages/modules/blog/blog.codecs.props" />
  <!-- C6: alerts codecs only on idealist (its RouteContract/AdminGen open Alerts.Codecs). -->
  <Import Project="../../../../packages/modules/alerts/alerts.codecs.props" Condition="'$(HEDGE_SITE)' == 'idealist'" />
  <!-- Identity HTTP codecs (IdentityHttp.Codecs) + typed client (IdentityHttp.ClientGen) now come from the
       shared IdentityHttp assembly (ProjectReference below) instead of per-app source compilation, so ONE
       IdentityHttp.Codecs serves both the server dispatch (transitively via this Codecs project) and the
       client-side Identity.Client. (identity.http.codecs.props is retired by this reference.) -->
  <!-- Mobile HTTP contracts (MobileHttp.Codecs) — the request/response codecs the server's
       MobileHttp.RouteContract dispatch opens. Microblog-only (Capacitor POC); MobileHttp.Api comes from
       MobileModels (referenced transitively via Models). Contributes no tables; import order is free. -->
  <Import Project="../../../../packages/modules/identity/mobile-http/identity.mobile-http.codecs.props" />
  <ItemGroup>
    <ProjectReference Include="../../../../packages/hedge/src/Hedge/Hedge.fsproj" />
    <ProjectReference Include="../Models/Models.fsproj" />
    <!-- Shared identity HTTP codecs + client assembly (promoted from per-app codecs). -->
    <ProjectReference Include="../../../../packages/modules/identity/http/IdentityHttp.fsproj" />
    <ProjectReference Include="../../../../packages/modules/blog/src/Models/BlogModels.fsproj" />
    <ProjectReference Include="../../../../packages/modules/alerts/src/Models/AlertsModels.fsproj" Condition="'$(HEDGE_SITE)' == 'idealist'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0" />
    <PackageReference Include="Thoth.Json" Version="10.2.0" />
  </ItemGroup>
</Project>
