<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Ws.fs" />

    <Compile Include="Api.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../packages/hedge/src/Hedge/Hedge.fsproj" />
    <!-- Shared identity schema (guests/identities) — module Models.Domain lives here now. -->
    <ProjectReference Include="../../../../packages/modules/identity/src/Models/IdentityModels.fsproj" />
    <!-- Opt-in access-control grants (module Grants.Domain) — microblog composes curator grants. -->
    <ProjectReference Include="../../../../packages/modules/identity/src/Grants/GrantModels.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0" />
  </ItemGroup>
</Project>
