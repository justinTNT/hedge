<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Env.fs" />
    <Compile Include="generated/Db.fs" />
  </ItemGroup>
  <!-- Shared identity persistence + handlers (Identity.Db / Sql / Server / Attribution / Handlers). Imported
       before GuestConfig / Handlers / ModuleServices, which call it. -->
  <Import Project="../../../../packages/modules/identity/identity.server.props" />
  <ItemGroup>
    <!-- Binds this app's Env + Identity.Server into the shared guest-session policy (Hedge.GuestSession). -->
    <Compile Include="GuestConfig.fs" />
  </ItemGroup>
  <!-- The calendar module's server layer (its own file list): after the app's generated Db, before the
       app's AttributionPolicy (which names Calendar.Sql/Db), AdminGen and Routes. -->
  <Import Project="../../../../packages/modules/calendar/calendar.server.props" />
  <ItemGroup>
    <Compile Include="AttributionPolicy.fs" />
    <Compile Include="Handlers.fs" />
    <Compile Include="generated/AdminGen.fs" />
    <Compile Include="AdminConfig.fs" />
    <Compile Include="generated/Routes.fs" />
  </ItemGroup>
  <!-- Identity HTTP module dispatch (IdentityHttp.RouteContract + Composition.bind): AFTER identity.server.props
       and BEFORE ModuleServices.fs (which runs the preflight + hands it the bound handlers). -->
  <Import Project="../../../../packages/modules/identity/http/identity.http.server.props" />
  <ItemGroup>
    <Compile Include="ModuleServices.fs" />
    <Compile Include="Worker.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../packages/hedge/src/Hedge/Hedge.fsproj" />
    <ProjectReference Include="../Models/Models.fsproj" />
    <ProjectReference Include="../../../../packages/modules/calendar/src/Models/CalendarModels.fsproj" />
    <ProjectReference Include="../Codecs/Codecs.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0" />
    <PackageReference Include="Fable.Promise" Version="3.2.0" />
    <PackageReference Include="Thoth.Json" Version="10.2.0" />
  </ItemGroup>
</Project>
