<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- The shared client runtime + presentation are now referenced libraries (Track 3): Hedge.Client
         (Client.Api/GuestSession), RichText (Client.RichText), ContentHostContext (Content.HostContext) and
         ContentClient (Content.ClaimGlue/Identity/IdentityView/Comments) — see the ProjectReferences below.
         Only this app's own generated transport client stays compiled in-assembly. -->
    <Compile Include="generated/ClientGen.fs" />
  </ItemGroup>
  <!-- Content module clients, composed via each module's own .props (it owns its
       file list). Imported after ClientGen/RichText; then the thin entries run each
       component: Articles/Main.fs is PRIMARY (served at "/"), Blog/Main.fs is the
       secondary /blog path-mount (justat only). -->
  <Import Project="../../../../packages/modules/articles/articles.client.props" />
  <!-- blog client composed everywhere EXCEPT ndct (articles-only) — see Server.fsproj. -->
  <Import Project="../../../../packages/modules/blog/blog.client.props" Condition="'$(HEDGE_SITE)' != 'ndct'" />
  <!-- ndct: articles standalone (no shell, no blog). CP-B: the single-module host (chrome +
       shared identity + router) that runs the articles module via its hosted surface, mirroring
       the Justat shell. Articles/Main.fs runs it. -->
  <ItemGroup Condition="'$(HEDGE_SITE)' == 'ndct'">
    <Compile Include="Articles/Chrome.fs" />
    <Compile Include="Articles/Host.fs" />
    <Compile Include="Articles/Main.fs" />
  </ItemGroup>
  <!-- default/justat: the unified shell (Stage 2) hosts BOTH content modules — articles
       at the root, blog at /blog — in one document. It references both modules' hosted
       surfaces, so it compiles after their .props. There is no standalone Blog/Main
       entry here any more; the blog module itself is still composed via blog.client.props. -->
  <ItemGroup Condition="'$(HEDGE_SITE)' != 'ndct'">
    <Compile Include="Shell/Config.fs" />
    <Compile Include="Shell/Types.fs" />
    <Compile Include="Shell/Chrome.fs" />
    <Compile Include="Shell/App.fs" />
    <Compile Include="Shell/Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Track 3 shared libraries (replace the former source includes above). -->
    <ProjectReference Include="../../../../packages/hedge/src/Client/Hedge.Client.fsproj" />
    <ProjectReference Include="../../../../packages/rich-text/RichText.fsproj" />
    <ProjectReference Include="../../../../packages/content-client/ContentHostContext.fsproj" />
    <ProjectReference Include="../../../../packages/content-client/ContentClient.fsproj" />
    <!-- Identity subsystem + connection UI (Content.Identity / Content.IdentityView), now its own
         identity-owned library (moved out of ContentClient). -->
    <ProjectReference Include="../../../../packages/modules/identity/client/Identity.Client.fsproj" />
    <ProjectReference Include="../../../../packages/hedge/src/Hedge/Hedge.fsproj" />
    <ProjectReference Include="../Models/Models.fsproj" />
    <ProjectReference Include="../../../../packages/modules/articles/src/Models/ArticlesModels.fsproj" />
    <ProjectReference Include="../../../../packages/modules/blog/src/Models/BlogModels.fsproj" />
    <ProjectReference Include="../Codecs/Codecs.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.16.0" />
    <PackageReference Include="Feliz" Version="2.9.0" />
    <PackageReference Include="Feliz.Router" Version="4.0.0" />
    <PackageReference Include="Fable.Elmish" Version="4.2.0" />
    <PackageReference Include="Fable.Elmish.React" Version="4.0.0" />
    <PackageReference Include="Fable.Elmish.HMR" Version="7.0.0" />
    <PackageReference Include="Thoth.Fetch" Version="3.0.1" />
  </ItemGroup>
</Project>
