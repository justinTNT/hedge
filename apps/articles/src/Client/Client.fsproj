<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="GuestSession.fs" />
    <Compile Include="Api.fs" />
    <Compile Include="generated/ClientGen.fs" />
    <Compile Include="../../../../packages/rich-text/RichText.fs" />
    <Compile Include="Types.fs" />
    <Compile Include="Shared.fs" />
    <Compile Include="Pages/Feed.fs" />
    <Compile Include="Pages/Item.fs" />
    <Compile Include="App.fs" />
    <!-- Blog module client (file-linked component) + its path-mount entry.
         References the composed Client.ClientGen (blog* fns) + shared RichText above. -->
    <Compile Include="../../../../packages/modules/blog/src/Client/GuestSession.fs" />
    <Compile Include="../../../../packages/modules/blog/src/Client/Api.fs" />
    <Compile Include="../../../../packages/modules/blog/src/Client/Types.fs" />
    <Compile Include="../../../../packages/modules/blog/src/Client/Shared.fs" />
    <Compile Include="../../../../packages/modules/blog/src/Client/Pages/Feed.fs" />
    <Compile Include="../../../../packages/modules/blog/src/Client/Pages/Item.fs" />
    <Compile Include="../../../../packages/modules/blog/src/Client/Pages/NewItem.fs" />
    <Compile Include="../../../../packages/modules/blog/src/Client/Pages/TagItems.fs" />
    <Compile Include="../../../../packages/modules/blog/src/Client/App.fs" />
    <Compile Include="Blog/Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../packages/hedge/src/Hedge/Hedge.fsproj" />
    <ProjectReference Include="../Models/Models.fsproj" />
    <ProjectReference Include="../../../../packages/modules/blog/src/Models/BlogModels.fsproj" />
    <ProjectReference Include="../Codecs/Codecs.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.16.0" />
    <PackageReference Include="Feliz" Version="2.9.0" />
    <PackageReference Include="Feliz.Router" Version="4.0.0" />
    <PackageReference Include="Fable.Elmish" Version="4.2.0" />
    <PackageReference Include="Fable.Elmish.React" Version="4.0.0" />
    <PackageReference Include="Fable.Elmish.HMR" Version="7.0.0" />
    <PackageReference Include="Thoth.Fetch" Version="3.0.1" />
  </ItemGroup>
</Project>
