<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared content-server contract (C3 author resolution) the content modules' handlers
         depend on instead of Server.Env/Server.Identity. Compiled once here, before the
         module server props, mirroring content-client at the Client level. -->
    <Compile Include="../../../../packages/content-server/Author.fs" />
    <Compile Include="Env.fs" />
    <Compile Include="generated/Db.fs" />
  </ItemGroup>
  <!-- Shared identity persistence (Identity.Db / Identity.Sql / Identity.Server) — the module-owned
       replacement for this app's old Server.Identity + Server.Sql (which were entirely the shared
       identity layer). Imported before GuestConfig / Handlers / ModuleServices, which call it. -->
  <Import Project="../../../../packages/modules/identity/identity.server.props" />
  <ItemGroup>
    <Compile Include="Attribution.fs" />
    <!-- Binds this app's Env + Identity.Server into the shared guest-session policy
         (Hedge.GuestSession). After the identity props (uses it); before the module props, Handlers,
         ModuleServices and Worker (all consume it). -->
    <Compile Include="GuestConfig.fs" />
  </ItemGroup>
  <!-- Content module server layers, composed via each module's own .props (it owns
       its file list). Imports sit between ItemGroups so the module files land here in
       compile order: after Db/Identity (which they use), before the app's identity
       Handlers, AdminGen and generated/Routes (which dispatches to their handlers). -->
  <Import Project="../../../../packages/modules/articles/articles.server.props" />
  <!-- blog is composed on every site EXCEPT ndct (articles-only). HEDGE_SITE drives
       both this import and the gen manifest (gen-modules.ndct.json omits blog), so
       ndct's generated Routes never reference Blog.Handlers. -->
  <Import Project="../../../../packages/modules/blog/blog.server.props" Condition="'$(HEDGE_SITE)' != 'ndct'" />
  <ItemGroup>
    <!-- The merge policy composes each composed module's own reassignComments, so it
         sits after the module props (needs Articles.Sql / Blog.Sql) and before Handlers
         (which calls it). Site-selected like the generated glue: default = articles+blog
         (justat), .ndct = articles-only. -->
    <Compile Include="AttributionPolicy.fs" Condition="'$(HEDGE_SITE)' != 'ndct'" />
    <Compile Include="AttributionPolicy.ndct.fs" Condition="'$(HEDGE_SITE)' == 'ndct'" />
    <Compile Include="Handlers.fs" />
    <!-- The per-composition glue (AdminGen registry + Routes dispatch) is committed
         per HEDGE_SITE: the default files are the superset (justat); ndct has its own
         .ndct files (articles-only, no Blog refs). schema.sql is suffixed the same way. -->
    <Compile Include="generated/AdminGen.fs" Condition="'$(HEDGE_SITE)' != 'ndct'" />
    <Compile Include="generated/AdminGen.ndct.fs" Condition="'$(HEDGE_SITE)' == 'ndct'" />
    <Compile Include="AdminConfig.fs" />
    <Compile Include="generated/Routes.fs" Condition="'$(HEDGE_SITE)' != 'ndct'" />
    <Compile Include="generated/Routes.ndct.fs" Condition="'$(HEDGE_SITE)' == 'ndct'" />
    <Compile Include="Meta.fs" />
    <!-- C3: binds each composed module's Services from Env + composes their dispatches; site-
         selected like the generated Routes (default = articles+blog; .ndct = articles-only). -->
    <Compile Include="ModuleServices.fs" Condition="'$(HEDGE_SITE)' != 'ndct'" />
    <Compile Include="ModuleServices.ndct.fs" Condition="'$(HEDGE_SITE)' == 'ndct'" />
    <Compile Include="Worker.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../packages/hedge/src/Hedge/Hedge.fsproj" />
    <ProjectReference Include="../Models/Models.fsproj" />
    <ProjectReference Include="../../../../packages/modules/articles/src/Models/ArticlesModels.fsproj" />
    <ProjectReference Include="../../../../packages/modules/blog/src/Models/BlogModels.fsproj" />
    <ProjectReference Include="../Codecs/Codecs.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0" />
    <PackageReference Include="Fable.Promise" Version="3.2.0" />
    <PackageReference Include="Thoth.Json" Version="10.2.0" />
  </ItemGroup>
</Project>
