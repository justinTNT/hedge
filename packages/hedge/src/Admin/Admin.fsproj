<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="RichText.fs" />
    <Compile Include="Blobs.fs" />
    <Compile Include="Api.fs" />
    <Compile Include="App.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Track 3: the admin-credential store (Client.AdminCredential) is now part of the shared Hedge.Client
         library, referenced instead of source-included. Admin's own RichText/Api (module Admin.*) are
         distinct and stay local. -->
    <ProjectReference Include="../Client/Hedge.Client.fsproj" />
    <ProjectReference Include="../Hedge/Hedge.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.16.0" />
    <PackageReference Include="Feliz" Version="2.9.0" />
    <PackageReference Include="Feliz.Router" Version="4.0.0" />
    <PackageReference Include="Fable.Elmish" Version="4.2.0" />
    <PackageReference Include="Fable.Elmish.React" Version="4.0.0" />
    <PackageReference Include="Fable.Elmish.HMR" Version="7.0.0" />
    <PackageReference Include="Thoth.Fetch" Version="3.0.1" />
  </ItemGroup>
</Project>
