<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Incomplete pattern matches are a build error here: a value added to a DU like
         Schema.FieldAttr must be handled at every match site (SchemaCodec, Gen, admin).
         An unhandled case is exactly the EditableDate admin-schema regression, which
         shipped as a mere warning. Fail the build instead. -->
    <WarningsAsErrors>$(WarningsAsErrors);FS0025</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Interface.fs" />
    <Compile Include="Tenant.fs" />
    <Compile Include="Schema.fs" />
    <Compile Include="SchemaCodec.fs" />
    <Compile Include="Validate.fs" />
    <Compile Include="Http.fs" />
    <Compile Include="Codec.fs" />
    <Compile Include="Workers.fs" />
    <Compile Include="GuestCookie.fs" />
    <Compile Include="GuestSession.fs" />
    <Compile Include="OAuth.fs" />
    <Compile Include="Router.fs" />
    <Compile Include="EventHub.fs" />
    <Compile Include="Events.fs" />
    <Compile Include="Admin.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0" />
    <PackageReference Include="Fable.Promise" Version="3.2.0" />
    <PackageReference Include="Thoth.Json" Version="10.2.0" />
  </ItemGroup>
</Project>
