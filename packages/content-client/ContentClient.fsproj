<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The GENERIC shared content-client presentation layer (namespace Content): the OAuth claim-return glue
    (ClaimGlue) and the comments renderer (Comments). The identity subsystem + its connection UI moved to
    the identity-owned Identity.Client library (packages/modules/identity/client) so it can reference the
    identity HTTP contract with the correct dependency direction. Explicit library dependencies:
    ContentHostContext (host nav/title contract), RichText (Client.RichText renderer), Hedge.Client
    (Client.Api / Client.GuestSession) and Hedge (wire types). The comments.css sibling stays delivered by
    each app's Vite/prep:lib pipeline — this project does not package or copy it. Distinct obj/ from
    ContentHostContext via this directory's Directory.Build.props.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>ContentClient</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ClaimGlue.fs" />
    <Compile Include="Comments.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="ContentHostContext.fsproj" />
    <ProjectReference Include="../rich-text/RichText.fsproj" />
    <ProjectReference Include="../hedge/src/Client/Hedge.Client.fsproj" />
    <ProjectReference Include="../hedge/src/Hedge/Hedge.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.16.0" />
    <PackageReference Include="Feliz" Version="2.9.0" />
    <PackageReference Include="Fable.Elmish" Version="4.2.0" />
    <PackageReference Include="Thoth.Json" Version="10.2.0" />
    <PackageReference Include="Thoth.Fetch" Version="3.0.1" />
  </ItemGroup>
</Project>
