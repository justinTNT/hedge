<Project>
  <!--
    The identity HTTP module's generated codecs (IdentityHttp.Codecs), for a consuming app's shared
    Codecs project to compose. IdentityHttp.Codecs depends only on Thoth.Json + Hedge.Codec +
    IdentityModels (the IdentityHttp.Api contracts — already referenced transitively by any app whose
    Models project references IdentityModels), and the app's generated RouteContract opens it, so import
    this into the Codecs project BEFORE anything that consumes IdentityHttp decoders. Contributes no
    tables (see identity.http.server.props); this is purely the request/response codec slice.
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)generated/Codecs.fs" />
  </ItemGroup>
</Project>
