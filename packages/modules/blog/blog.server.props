<Project>
  <!--
    The blog module's server layer, for a consuming app to compose.
    The app IMPORTs this (optionally Condition'd on $(HEDGE_SITE)) instead of
    reaching into the module's files by hand. Paths are $(MSBuildThisFileDirectory)-
    rooted so they resolve the same from any consumer.

    Ordering: Sql needs the consumer's generated Server.Db.Tables; Handlers needs
    Server.Identity + Codecs + Blog.Sql. So Import this AFTER the app's generated
    Db and Server.Identity, and BEFORE the app's own Handlers.fs (whose bespoke glue
    may read Blog.Sql, e.g. microblog's getRhymes) and BEFORE generated/Routes.fs
    (which dispatches to Blog.Handlers).
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)src/Server/Sql.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)src/Server/Handlers.fs" />
  </ItemGroup>
</Project>
