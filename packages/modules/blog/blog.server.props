<Project>
  <!--
    The blog module's server layer, for a consuming app to compose.
    The app IMPORTs this (optionally Condition'd on $(HEDGE_SITE)) instead of
    reaching into the module's files by hand. Paths are $(MSBuildThisFileDirectory)-
    rooted so they resolve the same from any consumer.

    Ordering: Blog.Db (generated surface) provides Tables + rows for Blog.Sql; Handlers
    needs Server.Identity + Blog.Codecs + Blog.Db + Blog.Sql; Blog.AdminGen must precede
    the app's site generated/AdminGen.fs (its registry appends Blog.AdminGen.tables). So
    Import this AFTER the app's generated Db + Server.Identity, and BEFORE the app's own
    Handlers.fs, generated/AdminGen.fs, and generated/Routes.fs.
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)generated/Db.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)src/Server/Sql.fs" />
    <!-- C3: the module's Services record (host capabilities) before its Handlers; then the
         generated RouteContract (Handlers record + dispatch) and the authored Composition.bind
         that closes handlers over a Services. The app imports content-server/Author.fs (before
         this props) and supplies the Services via Server.ModuleServices. -->
    <Compile Include="$(MSBuildThisFileDirectory)src/Server/Services.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)src/Server/Handlers.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)generated/RouteContract.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)src/Server/Composition.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)generated/AdminGen.fs" />
  </ItemGroup>
</Project>
