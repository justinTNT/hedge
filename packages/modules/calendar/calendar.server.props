<Project>
  <!--
    The calendar module's server layer, for a consuming app to compose. Paths are
    $(MSBuildThisFileDirectory)-rooted so they resolve the same from any consumer.

    Ordering: Calendar.Db (generated) provides Tables + rows for Calendar.Sql; Services before the
    Handlers that consume it; the generated RouteContract (Handlers record + dispatch) then the
    authored Composition.bind; Calendar.AdminGen last (its registry is appended by the app's site
    generated/AdminGen.fs). Import AFTER the app's generated Db, BEFORE the app's own Handlers,
    generated/AdminGen and generated/Routes. Calendar.Codecs is composed via calendar.codecs.props
    into the app's Codecs project (Handlers/RouteContract/AdminGen open it). No identity dependency:
    the host resolves the viewer into Services (Calendar.Services.guestOnly for an identity-less host).
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)generated/Db.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)src/Server/Sql.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)src/Server/Services.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)src/Server/Handlers.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)generated/RouteContract.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)src/Server/Composition.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)generated/AdminGen.fs" />
  </ItemGroup>
</Project>
