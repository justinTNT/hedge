<Project>
  <!--
    The articles module's server layer, for a consuming app to compose (mirrors
    blog.server.props). The app IMPORTs this instead of reaching into the module's
    files by hand. Paths are $(MSBuildThisFileDirectory)-rooted so they resolve the
    same from any consumer.

    Ordering: Sql needs the consumer's generated Server.Db.Tables; Handlers needs
    Server.Identity + Codecs + Articles.Sql. So Import this AFTER the app's generated
    Db and Server.Identity, and BEFORE the app's own Handlers.fs and BEFORE
    generated/Routes.fs (which dispatches to Articles.Handlers).
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)src/Server/Sql.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)src/Server/Handlers.fs" />
  </ItemGroup>
</Project>
