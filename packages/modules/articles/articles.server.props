<Project>
  <!--
    The articles module's server layer, for a consuming app to compose (mirrors
    blog.server.props). The app IMPORTs this instead of reaching into the module's
    files by hand. Paths are $(MSBuildThisFileDirectory)-rooted so they resolve the
    same from any consumer.

    Ordering: Articles.Db (generated surface) provides Tables + rows for Articles.Sql;
    Handlers needs Server.Identity + Articles.Codecs + Articles.Db + Articles.Sql;
    Articles.AdminGen must precede the app's site generated/AdminGen.fs (its registry
    appends Articles.AdminGen.tables). So Import this AFTER the app's generated Db +
    Server.Identity, and BEFORE the app's own Handlers.fs, generated/AdminGen.fs, and
    generated/Routes.fs.
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)generated/Db.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)src/Server/Sql.fs" />
    <!-- C3: Services (host capabilities) before Handlers; then the generated RouteContract
         (Handlers record + dispatch) and the authored Composition.bind. -->
    <Compile Include="$(MSBuildThisFileDirectory)src/Server/Services.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)src/Server/Handlers.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)generated/RouteContract.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)src/Server/Composition.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)generated/AdminGen.fs" />
  </ItemGroup>
</Project>
